{
  "name": "poketeam",
  "module": "server.ts",
  "type": "module",
  "private": true,
  "workspaces": ["packages/*"],
  "scripts": {
    "dev": "bun --hot server.ts",
    "start": "bun server.ts",
    "build:db": "bun packages/data/build.ts"
  },
  "dependencies": {
    "@poketeam/agent": "workspace:*",
    "@poketeam/data": "workspace:*",
    "@poketeam/store": "workspace:*",
    "@poketeam/web": "workspace:*"
  }
}
